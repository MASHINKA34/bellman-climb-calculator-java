<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 и новее: то же, что backup_rules.xml, для копии в облако и переноса на другой телефон -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="access.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="access.xml" />
    </device-transfer>
</data-extraction-rules>
